    {
      "name": "search_orders",
      "description": "Find orders by customer email, phone, name, order number, or Razorpay payment/order id.\n        All given criteria must match (AND). Use for \"I paid but my order failed\" style questions.\n        Lookups by Razorpay id scan recent orders only; check scan_complete.",
      "inputSchema": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "maxLength": 254,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact billing email",
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "pattern": "^\\+?[\\d\\s-]{4,20}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Billing phone, or at least its last 4 digits",
            "title": "Phone"
          },
          "customer_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Customer Name"
          },
          "order_number": {
            "anyOf": [
              {
                "pattern": "^\\d{1,12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Order number shown to the customer",
            "title": "Order Number"
          },
          "razorpay_payment_id": {
            "anyOf": [
              {
                "pattern": "^pay_[A-Za-z0-9]{6,40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Razorpay Payment Id"
          },
          "razorpay_order_id": {
            "anyOf": [
              {
                "pattern": "^order_[A-Za-z0-9]{6,40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Razorpay Order Id"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "pending",
                  "processing",
                  "on-hold",
                  "completed",
                  "cancelled",
                  "refunded",
                  "failed",
                  "checkout-draft"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "created_after": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "YYYY-MM-DD",
            "title": "Created After"
          },
          "created_before": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "YYYY-MM-DD",
            "title": "Created Before"
          },
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "search_ordersArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "OrderSummary": {
            "properties": {
              "order_id": {
                "title": "Order Id",
                "type": "integer"
              },
              "number": {
                "title": "Number",
                "type": "string"
              },
              "status": {
                "title": "Status",
                "type": "string"
              },
              "created_at": {
                "title": "Created At",
                "type": "string"
              },
              "total": {
                "title": "Total",
                "type": "string"
              },
              "currency": {
                "title": "Currency",
                "type": "string"
              },
              "payment_method": {
                "title": "Payment Method",
                "type": "string"
              },
              "customer_name": {
                "title": "Customer Name",
                "type": "string"
              },
              "item_count": {
                "title": "Item Count",
                "type": "integer"
              }
            },
            "required": [
              "order_id",
              "number",
              "status",
              "created_at",
              "total",
              "currency",
              "payment_method",
              "customer_name",
              "item_count"
            ],
            "title": "OrderSummary",
            "type": "object"
          }
        },
        "properties": {
          "orders": {
            "items": {
              "$ref": "#/$defs/OrderSummary"
            },
            "title": "Orders",
            "type": "array"
          },
          "matched": {
            "title": "Matched",
            "type": "integer"
          },
          "scanned_orders": {
            "title": "Scanned Orders",
            "type": "integer"
          },
          "scan_complete": {
            "description": "False means older orders were not searched; narrow by date to go further",
            "title": "Scan Complete",
            "type": "boolean"
          },
          "as_of": {
            "title": "As Of",
            "type": "string"
          }
        },
        "required": [
          "orders",
          "matched",
          "scanned_orders",
          "scan_complete",
          "as_of"
        ],
        "title": "OrderSearchResult",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }

    {
      "name": "get_order_payment_context",
      "description": "Advisory payment verdict for one order, built for \"money was debited but my order failed\".\n        Verdicts: paid, refunded, mismatch, payment_pending, payment_failed, cancelled_unpaid, not_razorpay,\n        needs_review. Includes the evidence (reasons) and a suggested next step. Escalate 'mismatch'.",
      "inputSchema": {
        "properties": {
          "order_id": {
            "description": "WooCommerce order id",
            "minimum": 1,
            "title": "Order Id",
            "type": "integer"
          }
        },
        "required": [
          "order_id"
        ],
        "title": "get_order_payment_contextArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "order_id": {
            "title": "Order Id",
            "type": "integer"
          },
          "verdict": {
            "enum": [
              "paid",
              "refunded",
              "mismatch",
              "payment_pending",
              "payment_failed",
              "cancelled_unpaid",
              "not_razorpay",
              "needs_review"
            ],
            "title": "Verdict",
            "type": "string"
          },
          "order_status": {
            "title": "Order Status",
            "type": "string"
          },
          "payment_method": {
            "title": "Payment Method",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "razorpay_payment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Razorpay Payment Id"
          },
          "razorpay_order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Razorpay Order Id"
          },
          "paid_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid At"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "suggested_next_step": {
            "title": "Suggested Next Step",
            "type": "string"
          },
          "advisory": {
            "default": "Derived from WooCommerce records only. Razorpay is the source of truth for money movement; never promise a refund or confirm capture from this alone.",
            "title": "Advisory",
            "type": "string"
          },
          "as_of": {
            "title": "As Of",
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "verdict",
          "order_status",
          "payment_method",
          "total",
          "currency",
          "razorpay_payment_id",
          "razorpay_order_id",
          "paid_at",
          "reasons",
          "suggested_next_step",
          "as_of"
        ],
        "title": "PaymentContext",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },

# Copy to .env for a real store. For the Docker demo, `make seed` writes docker/out/keys.env instead.
# Create the key in wp-admin -> WooCommerce -> Settings -> Advanced -> REST API, permission: Read.
WOO_BASE_URL=https://your-store.example.com
WOO_CONSUMER_KEY=ck_replace_me
WOO_CONSUMER_SECRET=cs_replace_me

# Optional
# WOO_CA_BUNDLE=path/to/self-signed.pem   # only for self-signed stores
# WOO_ALLOW_INSECURE_HTTP=false           # never true in production
# WOO_RATE_PER_SEC=4
# WOO_BURST=4
# WOO_MAX_CONCURRENCY=4
# WOO_MASK_PII=true
# WOO_PAYMENT_SCAN_MAX_ORDERS=300
